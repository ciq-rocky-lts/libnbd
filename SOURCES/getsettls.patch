From 7b8e59bc206e47e5fd83404aca8a177c955f2c0a Mon Sep 17 00:00:00 2001
From: "Richard W.M. Jones" <rjones@redhat.com>
Date: Wed, 26 Jun 2024 09:30:53 +0100
Subject: [PATCH 3/4] lib/uri.c: Append tls-hostname and tls-verify-peer when
 getting URI

When using nbd_get_uri, append tls-hostname and tls-verify-peer if
needed.  This also adds a simple pair of tests.

Updates: commit e62185645c4d1a833d40aa79f3fee4ed477827c2
Updates: commit 75641c6b30155abce272f60cf3518a65654aa401
(cherry picked from commit 029352d6e84a3dc7b8d13b956b468c00d007bcd9)
---
 .gitignore        |  2 ++
 lib/uri.c         | 10 ++++++++++
 tests/Makefile.am | 34 ++++++++++++++++++++++++++++++++++
 3 files changed, 46 insertions(+)

diff --git a/.gitignore b/.gitignore
index 899300a..3bc49be 100644
--- a/.gitignore
+++ b/.gitignore
@@ -224,6 +224,8 @@ Makefile.in
 /tests/connect-uri-nbds-certs
 /tests/connect-uri-nbds-psk
 /tests/connect-uri-nbds-unix-certs
+/tests/connect-uri-nbds-unix-tls-hostname
+/tests/connect-uri-nbds-unix-tls-verify-peer-false
 /tests/connect-uri-nbds-unix-psk
 /tests/debug
 /tests/debug-environment
diff --git a/lib/uri.c b/lib/uri.c
index 7919888..0393776 100644
--- a/lib/uri.c
+++ b/lib/uri.c
@@ -580,6 +580,16 @@ nbd_unlocked_get_uri (struct nbd_handle *h)
                              "tls-psk-file", h->tls_psk_file) == -1)
       goto out;
   }
+  if (h->tls_hostname) {
+    if (append_query_params (&query_params,
+                             "tls-hostname", h->tls_hostname) == -1)
+      goto out;
+  }
+  if (! h->tls_verify_peer) {
+    if (append_query_params (&query_params,
+                             "tls-verify-peer", "false") == -1)
+      goto out;
+  }
 
   uri.query_raw = query_params;
 
diff --git a/tests/Makefile.am b/tests/Makefile.am
index 1236164..ca0a908 100644
--- a/tests/Makefile.am
+++ b/tests/Makefile.am
@@ -810,10 +810,14 @@ if HAVE_CERTTOOL
 check_PROGRAMS += \
 	connect-uri-nbds-certs \
 	connect-uri-nbds-unix-certs \
+	connect-uri-nbds-unix-tls-hostname \
+	connect-uri-nbds-unix-tls-verify-peer-false \
 	$(NULL)
 TESTS += \
 	connect-uri-nbds-certs \
 	connect-uri-nbds-unix-certs \
+	connect-uri-nbds-unix-tls-hostname \
+	connect-uri-nbds-unix-tls-verify-peer-false \
 	$(NULL)
 
 connect_uri_nbds_certs_SOURCES = \
@@ -842,6 +846,36 @@ connect_uri_nbds_unix_certs_CPPFLAGS = \
 	$(NULL)
 connect_uri_nbds_unix_certs_LDADD = $(top_builddir)/lib/libnbd.la
 
+connect_uri_nbds_unix_tls_hostname_SOURCES = \
+	connect-uri.c \
+	requires.c requires.h pick-a-port.c pick-a-port.h \
+	$(NULL)
+connect_uri_nbds_unix_tls_hostname_CPPFLAGS = \
+	$(AM_CPPFLAGS) \
+	-DDEFINE_STR_AS_UNIX_SOCKET=1 \
+	-DSERVER_PARAMS='"-U", str, "--tls=require", "--tls-verify-peer", "--tls-certificates=pki"' \
+	-DREQUIRES_NBDKIT_TLS_VERIFY_PEER=1 \
+	-DURI='"nbds+unix://alice@/?tls-certificates=pki&socket=%s&tls-hostname=localhost", str' \
+	$(NULL)
+connect_uri_nbds_unix_tls_hostname_LDADD = \
+	$(top_builddir)/lib/libnbd.la \
+	$(NULL)
+
+connect_uri_nbds_unix_tls_verify_peer_false_SOURCES = \
+	connect-uri.c \
+	requires.c requires.h pick-a-port.c pick-a-port.h \
+	$(NULL)
+connect_uri_nbds_unix_tls_verify_peer_false_CPPFLAGS = \
+	$(AM_CPPFLAGS) \
+	-DDEFINE_STR_AS_UNIX_SOCKET=1 \
+	-DSERVER_PARAMS='"-U", str, "--tls=require", "--tls-verify-peer", "--tls-certificates=pki"' \
+	-DREQUIRES_NBDKIT_TLS_VERIFY_PEER=1 \
+	-DURI='"nbds+unix://alice@/?tls-certificates=pki&socket=%s&tls-verify-peer=false", str' \
+	$(NULL)
+connect_uri_nbds_unix_tls_verify_peer_false_LDADD = \
+	$(top_builddir)/lib/libnbd.la \
+	$(NULL)
+
 endif HAVE_CERTTOOL
 
 if HAVE_PSKTOOL
-- 
