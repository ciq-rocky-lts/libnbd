Subject: [PATCH 2/4] lib/uri.c: Allow tls-hostname to be overridden in URIs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Suggested-by: Daniel Berrangé
Reviewed-by: Daniel P. Berrangé <berrange@redhat.com>
(cherry picked from commit e62185645c4d1a833d40aa79f3fee4ed477827c2)
---
 generator/API.ml | 4 ++++
 lib/uri.c        | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/generator/API.ml b/generator/API.ml
index 43922a8..089bea2 100644
--- a/generator/API.ml
+++ b/generator/API.ml
@@ -2032,6 +2032,10 @@ Note this is not allowed by default - see next section.
 Set the PSK file.  See L<nbd_set_tls_psk_file(3)>.  Note
 this is not allowed by default - see next section.
 
+=item B<tls-hostname=>C<SERVER>
+
+Set the TLS hostname.  See L<nbd_set_tls_hostname(3)>.
+
 =item B<tls-verify-peer=false>
 
 Do not verify the server certificate.  See L<nbd_set_tls_verify_peer(3)>.
diff --git a/lib/uri.c b/lib/uri.c
index 30a9290..7919888 100644
--- a/lib/uri.c
+++ b/lib/uri.c
@@ -324,6 +324,10 @@ nbd_unlocked_aio_connect_uri (struct nbd_handle *h, const char *raw_uri)
       if (nbd_unlocked_set_tls_psk_file (h, queries.ptr[i].value) == -1)
         goto cleanup;
     }
+    else if (strcasecmp (queries.ptr[i].name, "tls-hostname") == 0) {
+      if (nbd_unlocked_set_tls_hostname (h, queries.ptr[i].value) == -1)
+        goto cleanup;
+    }
     else if (strcasecmp (queries.ptr[i].name, "tls-verify-peer") == 0) {
       int v = parse_bool ("tls-verify-peer", queries.ptr[i].value);
       if (v == -1)
-- 
