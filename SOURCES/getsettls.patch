From 325d2535915d2d087ac9c0f1144cc329679da8ab Mon Sep 17 00:00:00 2001
From: "Richard W.M. Jones" <rjones@redhat.com>
Date: Tue, 25 Jun 2024 11:36:05 +0100
Subject: [PATCH 1/4] lib/crypto.c: Add API functions to get/set TLS hostname
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Allow the TLS hostname (server name) to be optionally set independent
of the hostname we are connecting to.  This gives more flexiblity when
connecting to a TLS server through a proxy, allowing the server
certificate to be verified correctly in this case.

Suggested-by: Daniel Berrangé
Reviewed-by: Daniel P. Berrangé <berrange@redhat.com>
(cherry picked from commit 7a45b5db68c59cc620ba328f0ebec1e7058cd95a)
---
 .gitignore          |  1 +
 generator/API.ml    | 36 +++++++++++++++++++++++++++++-
 interop/Makefile.am | 25 +++++++++++++++++++++
 interop/interop.c   |  6 +++++
 lib/crypto.c        | 54 +++++++++++++++++++++++++++++++++++++++++++--
 lib/handle.c        |  1 +
 lib/internal.h      |  1 +
 7 files changed, 121 insertions(+), 3 deletions(-)

diff --git a/.gitignore b/.gitignore
index 2311caa..899300a 100644
--- a/.gitignore
+++ b/.gitignore
@@ -115,6 +115,7 @@ Makefile.in
 /interop/interop-nbdkit-tls-certs-allow-enabled
 /interop/interop-nbdkit-tls-certs-allow-fallback
 /interop/interop-nbdkit-tls-certs-bad-CA
+/interop/interop-nbdkit-tls-certs-bad-hostname
 /interop/interop-nbdkit-tls-psk
 /interop/interop-nbdkit-tls-psk-allow-enabled
 /interop/interop-nbdkit-tls-psk-allow-fallback
diff --git a/generator/API.ml b/generator/API.ml
index 9175310..43922a8 100644
--- a/generator/API.ml
+++ b/generator/API.ml
@@ -777,7 +777,8 @@ This function may be called regardless of whether TLS is
 supported, but will have no effect unless L<nbd_set_tls(3)>
 is also used to request or require TLS.";
     example = Some "examples/encryption.c";
-    see_also = [Link "get_tls_username"; Link "set_tls"];
+    see_also = [Link "get_tls_username"; Link "set_tls_hostname";
+                Link "set_tls"];
   };
 
   "get_tls_username", {
@@ -789,6 +790,35 @@ Get the current TLS username.";
     see_also = [Link "set_tls_username"];
   };
 
+  "set_tls_hostname", {
+    default_call with
+    args = [String "hostname"]; ret = RErr;
+    permitted_states = [ Created ];
+    shortdesc = "set the TLS hostname";
+    longdesc = "\
+Set the TLS server hostname.  This is used in preference to the
+hostname supplied when connecting (eg. through L<nbd_connect_tcp(3)>),
+or when there is no explicit hostname at all (L<nbd_connect_unix(3)>).
+It can be useful when you are connecting to a proxy which is forwarding
+the data to the final server, to specify the name of the final server
+so that the server's certificate can be checked.
+
+This function may be called regardless of whether TLS is
+supported, but will have no effect unless L<nbd_set_tls(3)>
+is also used to request or require TLS.";
+    see_also = [Link "set_tls_username"; Link "set_tls"];
+  };
+
+  "get_tls_hostname", {
+    default_call with
+    args = []; ret = RString;
+    shortdesc = "get the effective TLS hostname";
+    longdesc = "\
+Get the TLS server hostname in effect.  If not set, this returns
+the empty string (not an error).";
+    see_also = [Link "set_tls_hostname"];
+  };
+
   "set_tls_psk_file", {
     default_call with
     args = [Path "filename"]; ret = RErr;
@@ -4390,6 +4420,10 @@ let first_version = [
   "block_status_filter", (1, 18);
   "aio_block_status_filter", (1, 18);
 
+  (* Added in 1.21.x development cycle, will be stable and supported in 1.22 *)
+  "set_tls_hostname", (1, 22);
+  "get_tls_hostname", (1, 22);
+
   (* These calls are proposed for a future version of libnbd, but
    * have not been added to any released version so far.
   "get_tls_certificates", (1, ??);
diff --git a/interop/Makefile.am b/interop/Makefile.am
index 18b6a30..319f120 100644
--- a/interop/Makefile.am
+++ b/interop/Makefile.am
@@ -280,6 +280,7 @@ check_PROGRAMS += \
 	interop-nbdkit-tls-certs-allow-enabled \
 	interop-nbdkit-tls-certs-allow-fallback \
 	interop-nbdkit-tls-certs-bad-CA \
+	interop-nbdkit-tls-certs-bad-hostname \
 	interop-nbdkit-tls-psk \
 	interop-nbdkit-tls-psk-allow-enabled \
 	interop-nbdkit-tls-psk-allow-fallback \
@@ -292,6 +293,7 @@ TESTS += \
 	interop-nbdkit-tls-certs-allow-enabled \
 	interop-nbdkit-tls-certs-allow-fallback \
 	interop-nbdkit-tls-certs-bad-CA \
+	interop-nbdkit-tls-certs-bad-hostname \
 	interop-nbdkit-tls-psk \
 	interop-nbdkit-tls-psk-allow-enabled \
 	interop-nbdkit-tls-psk-allow-fallback \
@@ -390,6 +392,29 @@ interop_nbdkit_tls_certs_bad_CA_LDADD = \
 	$(GNUTLS_LIBS) \
 	$(NULL)
 
+# This test is expected to fail because even though the CA is correct,
+# we override tls_hostname with a bogus server name that won't match
+# the server's certificate.
+interop_nbdkit_tls_certs_bad_hostname_SOURCES = \
+	interop.c \
+	requires.c \
+	../tests/requires.h \
+	$(NULL)
+interop_nbdkit_tls_certs_bad_hostname_CPPFLAGS = \
+	$(AM_CPPFLAGS) \
+	-DREQUIRES=' requires ("test -d ../tests/pki"); ' \
+	-DSERVER=\"$(NBDKIT)\" \
+	-DSERVER_PARAMS='"--tls=require", "--tls-certificates=../tests/pki", "-s", "--exit-with-parent", "null"' \
+	-DCERTS='"../tests/pki"' \
+	-DTLS_MODE=LIBNBD_TLS_REQUIRE \
+	-DTLS_HOSTNAME='"this.is.bad.example.com"' \
+	-DEXPECT_FAIL=1 \
+	$(NULL)
+interop_nbdkit_tls_certs_bad_hostname_LDADD = \
+	$(top_builddir)/lib/libnbd.la \
+	$(GNUTLS_LIBS) \
+	$(NULL)
+
 interop_nbdkit_tls_psk_SOURCES = \
 	interop.c \
 	requires.c \
diff --git a/interop/interop.c b/interop/interop.c
index 07b64b8..1ea0216 100644
--- a/interop/interop.c
+++ b/interop/interop.c
@@ -145,7 +145,13 @@ main (int argc, char *argv[])
     fprintf (stderr, "%s\n", nbd_get_error ());
     exit (EXIT_FAILURE);
   }
+#ifdef TLS_HOSTNAME
+  if (nbd_set_tls_hostname (nbd, TLS_HOSTNAME) == -1) {
+    fprintf (stderr, "%s\n", nbd_get_error ());
+    exit (EXIT_FAILURE);
+  }
 #endif
+#endif /* TLS */
 
 #if defined(CERTS)
   const char *certs = CERTS;
diff --git a/lib/crypto.c b/lib/crypto.c
index 0dbd485..e7aee21 100644
--- a/lib/crypto.c
+++ b/lib/crypto.c
@@ -163,6 +163,51 @@ nbd_unlocked_get_tls_username (struct nbd_handle *h)
   }
 }
 
+int
+nbd_unlocked_set_tls_hostname (struct nbd_handle *h, const char *hostname)
+{
+  char *new_hostname;
+
+  new_hostname = strdup (hostname);
+  if (!new_hostname) {
+    set_error (errno, "strdup");
+    return -1;
+  }
+  free (h->tls_hostname);
+  h->tls_hostname = new_hostname;
+  return 0;
+}
+
+static const char *
+get_tls_hostname (struct nbd_handle *h)
+{
+  if (h->tls_hostname)
+    return h->tls_hostname;
+  else if (h->hostname)
+    return h->hostname;
+  else
+    return NULL;
+}
+
+char *
+nbd_unlocked_get_tls_hostname (struct nbd_handle *h)
+{
+  const char *hostname = get_tls_hostname (h);
+  char *ret;
+
+  if (hostname)
+    ret = strdup (hostname);
+  else
+    /* Otherwise, return "" (not an error). */
+    ret = strdup ("");
+
+  if (ret == NULL) {
+    set_error (errno, "strdup");
+    return NULL;
+  }
+  return ret;
+}
+
 int
 nbd_unlocked_set_tls_psk_file (struct nbd_handle *h, const char *filename)
 {
@@ -649,8 +694,13 @@ nbd_internal_crypto_create_session (struct nbd_handle *h,
       return NULL;
     }
 
-    if (h->tls_verify_peer)
-      gnutls_session_set_verify_cert (session, h->hostname, 0);
+    if (h->tls_verify_peer) {
+      /* Verify the server certificate using h->tls_hostname, falling
+       * back to h->hostname.
+       */
+      const char *hostname = get_tls_hostname (h);
+      gnutls_session_set_verify_cert (session, hostname, 0);
+    }
   }
 
   /* Wrap the underlying socket with GnuTLS. */
diff --git a/lib/handle.c b/lib/handle.c
index 980649a..196018b 100644
--- a/lib/handle.c
+++ b/lib/handle.c
@@ -173,6 +173,7 @@ nbd_close (struct nbd_handle *h)
   free (h->sact_name);
   free (h->tls_certificates);
   free (h->tls_username);
+  free (h->tls_hostname);
   free (h->tls_psk_file);
   string_vector_empty (&h->request_meta_contexts);
   free (h->hname);
diff --git a/lib/internal.h b/lib/internal.h
index f446057..d1fc971 100644
--- a/lib/internal.h
+++ b/lib/internal.h
@@ -117,6 +117,7 @@ struct nbd_handle {
   char *tls_certificates;       /* Certs dir, NULL = use default path */
   bool tls_verify_peer;         /* Verify the peer certificate. */
   char *tls_username;           /* Username, NULL = use current username */
+  char *tls_hostname;           /* TLS hostname */
   char *tls_psk_file;           /* PSK filename, NULL = no PSK */
 
   /* Extended headers. */
-- 
